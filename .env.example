# Variables de entorno de AgroCitrico.
# Copia este archivo a .env y rellena los valores reales. Nunca subas .env al repo.

# Flask
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-segura
# En produccion (HTTPS) debe ser True; en local http dejalo en False.
SESSION_COOKIE_SECURE=False

# Base de datos MySQL
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agrocitrico

# Cifrado en reposo (Fernet). Genera la clave con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=tu_fernet_key

# Token compartido con los dispositivos/sensores IoT
SENSOR_TOKEN=token-del-dispositivo

# Email transaccional (Resend)
RESEND_API_KEY=re_tu_api_key
RESEND_FROM_EMAIL=AgroCitrico <no-reply@tudominio.com>
